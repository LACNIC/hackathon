# Plantilla local para runtime y testing UI. Copiar como:
# ai-harness-local/testing/.env
# No versionar el archivo con secretos reales.

AI_HARNESS_APP_BASE_URL=http://localhost:8080/app
AI_HARNESS_APP_HEALTH_URL=http://localhost:8080/app
AI_HARNESS_APP_LOGIN_URL=http://localhost:8080/app/login

AI_HARNESS_TEST_USERNAME=
AI_HARNESS_TEST_PASSWORD=
AI_HARNESS_TEST_ROLE=

AI_HARNESS_PLAYWRIGHT_STORAGE_STATE=ai-harness-local/testing/.auth/state.json
AI_HARNESS_PLAYWRIGHT_COMMAND=playwright-cli

# Ghost Inspector usa este mismo .env. Nunca pasar la key por argumento.
AI_HARNESS_PROJECT_NAME=
AI_HARNESS_PROJECT_KEY=
GHOST_INSPECTOR_API_KEY=
GHOST_INSPECTOR_API_BASE=https://api.ghostinspector.com/v1
GHOST_INSPECTOR_ORGANIZATION_ID=
GHOST_INSPECTOR_FOLDER_ID=
GHOST_INSPECTOR_FOLDER_NAME=
GHOST_INSPECTOR_TIMEOUT_SECONDS=30
GHOST_INSPECTOR_RETRIES=2
GHOST_INSPECTOR_POLL_SECONDS=10
GHOST_INSPECTOR_POLL_TIMEOUT_SECONDS=1200
